  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurador: Archivo local",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Argumentos",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": ["--borradores"]
    },
    {
      "name": "Python: Planilla 2EM-A",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/planilla.py",
      "console": "integratedTerminal",
      "args": [
        "https://docs.google.com/spreadsheets/d/1o_RJX87N5u1wD5czzztli-RAt-sFYF_k/",
        "--curso",
        "2EM-A",
        "--salida-curso",
        "google_sheets/curso_2EM-A.csv",
        "--range",
        "A:B;H:H;K:K"
      ]
    },
  ]
}
